{
  "expo": {
    "name": "Khatma",
    "slug": "Khatma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.jpg",
    "scheme": "khatmarn",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/app-icon.jpg"
    },
    "android": {
      "icon": "./assets/images/app-icon.jpg",
      "adaptiveIcon": {
        "backgroundColor": "#121E1A",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app-icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14271C",
          "image": "./assets/images/logo.png",
          "imageWidth": 260
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
